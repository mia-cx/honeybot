# Discord bot token from the Discord Developer Portal.
# Required. Example: DISCORD_TOKEN=MT...
DISCORD_TOKEN=replace-me

# Log verbosity.
# Accepted values: debug | info | warn | error
LOG_LEVEL=info

# SQLite database URL for durable Honeybot state.
# Accepted format for MVP: file:<path>
DATABASE_URL=file:data/honeybot.sqlite

# Evidence/image storage backend.
# Accepted values: filesystem
# Future values may include: sqlite | s3
IMAGE_STORAGE_DRIVER=filesystem

# Directory used when IMAGE_STORAGE_DRIVER=filesystem.
# Mount the parent data/ directory as a persistent Docker/Railway volume.
IMAGE_STORAGE_DIR=data/images

# Base64-encoded 32-byte key used to encrypt per-guild BYOK API keys.
# Required once BYOK storage is implemented. Losing this makes stored keys unrecoverable.
API_KEY_ENCRYPTION_KEY=base64-encoded-32-byte-key

# Default provider API key for OpenRouter-backed model calls.
# Guild /model settings can override with encrypted per-purpose BYOK keys.
OPENROUTER_API_KEY=replace-me

# Primary classifier providers/models.
# Text path sends text-only payloads; image path sends text plus image attachments.
DEFAULT_TEXT_PRIMARY_PROVIDER=openrouter
DEFAULT_TEXT_PRIMARY_MODEL=google/gemma-4-26b-a4b-it:free
DEFAULT_IMAGE_PRIMARY_PROVIDER=openrouter
DEFAULT_IMAGE_PRIMARY_MODEL=google/gemma-4-26b-a4b-it:free

# Comma-separated classifier models that get the same prompt as the matching
# primary classifier and contribute advisory second/third-opinion signals.
# They do not independently trigger auto-punishment.
ADDITIONAL_TEXT_SIGNAL_PROVIDER=openrouter
ADDITIONAL_TEXT_SIGNAL_MODELS=nvidia/nemotron-3.5-content-safety:free
ADDITIONAL_IMAGE_SIGNAL_PROVIDER=openrouter
ADDITIONAL_IMAGE_SIGNAL_MODELS=nvidia/nemotron-3.5-content-safety:free

# Default text embeddings provider.
# Accepted values: openrouter | custom
DEFAULT_TEXT_EMBEDDINGS_PROVIDER=openrouter

# Default text embeddings model ID.
# For hosted OpenRouter defaults, use google/gemini-embedding-2.
DEFAULT_TEXT_EMBEDDINGS_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free

# Default image embeddings provider.
# Accepted values: openrouter | custom
DEFAULT_IMAGE_EMBEDDINGS_PROVIDER=openrouter

# Default image embeddings model ID.
# For hosted OpenRouter defaults, use google/gemini-embedding-2.
DEFAULT_IMAGE_EMBEDDINGS_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free

# Output dimensions for embeddings.
# Valid values for google/gemini-embedding-2: 768 | 1536 | 3072
# nvidia/llama-nemotron-embed-vl-1b-v2:free always returns 2048; Honeybot stores
# that returned size and does not send a dimension override for that fixed-size model.
DEFAULT_EMBEDDINGS_DIMENSIONS=2048

# Deployment-global rolling-window model/provider call limit.
# Exhaustion should fail cases to moderator review after retry/deadline policy.
MODEL_CALL_LIMIT=60

# Per-guild rolling-window model/provider call limit. Uses MODEL_CALL_WINDOW_SECONDS.
MODEL_CALL_LIMIT_PER_GUILD=20

# Rolling-window duration for model call limits, in seconds.
MODEL_CALL_WINDOW_SECONDS=60

# Max model retry attempts for transient failures.
MODEL_RETRY_MAX_ATTEMPTS=3

# Initial exponential-backoff delay for model retries, in milliseconds.
MODEL_RETRY_INITIAL_DELAY_MS=500

# Maximum exponential-backoff delay for model retries, in milliseconds.
MODEL_RETRY_MAX_DELAY_MS=5000

# Deployment-global rolling-window Discord moderation action limit.
# Used to avoid bursts fighting Discord API limits.
MODERATION_ACTION_LIMIT=30

# Per-guild rolling-window Discord moderation action limit. Uses MODERATION_ACTION_WINDOW_SECONDS.
MODERATION_ACTION_LIMIT_PER_GUILD=10

# Rolling-window duration for moderation action limits, in seconds.
MODERATION_ACTION_WINDOW_SECONDS=60

# Optional local/private eval corpus directory.
# Example: EVAL_CORPUS_DIR=/Users/me/Downloads
EVAL_CORPUS_DIR=

# Global authority mode for global-ban publishing and global corpus promotion.
# Accepted values: team | users
GLOBAL_AUTH_MODE=team

# Discord Developer Team ID used when GLOBAL_AUTH_MODE=team.
# Example: GLOBAL_AUTH_TEAM_ID=your-team-id
GLOBAL_AUTH_TEAM_ID=replace-me

# Comma-separated Discord user IDs used when GLOBAL_AUTH_MODE=users.
GLOBAL_AUTH_USER_IDS=

# -----------------------------------------------------------------------------
# Per-guild deployment defaults
# -----------------------------------------------------------------------------
# These override Honeybot's in-code defaults for newly initialized guilds.
# Precedence: in-code constants < deployment env defaults < per-guild Discord settings.
# Existing per-guild settings in SQLite are never overwritten by these values.

# Optional default moderation channel ID for case feed messages.
HONEYBOT_DEFAULT_MODERATION_CHANNEL_ID=

# Optional comma-separated default honeypot channel IDs.
HONEYBOT_DEFAULT_HONEYPOT_CHANNEL_IDS=

# Optional comma-separated default moderator user/role IDs.
HONEYBOT_DEFAULT_MODERATOR_USER_IDS=
HONEYBOT_DEFAULT_MODERATOR_ROLE_IDS=

# Cross-channel trigger defaults.
# Booleans accept true/false, 1/0, yes/no, on/off.
HONEYBOT_DEFAULT_CROSSCHANNEL_ENABLED=true
HONEYBOT_DEFAULT_CROSSCHANNEL_WINDOW_SECONDS=60
HONEYBOT_DEFAULT_CROSSCHANNEL_CHANNEL_THRESHOLD=2

# Evidence/corpus thresholds use decimal fractions between 0 and 1.
HONEYBOT_DEFAULT_KNOWN_IMAGE_SIMILARITY_THRESHOLD=0.92
HONEYBOT_DEFAULT_KNOWN_TEXT_SIMILARITY_THRESHOLD=0.82
HONEYBOT_DEFAULT_EVIDENCE_CONFIDENCE_THRESHOLD=0.90

# Review and notification defaults.
HONEYBOT_DEFAULT_AUTO_PUNISH_ENABLED=false
HONEYBOT_DEFAULT_PUNISHMENT_DM_NOTIFY=true
HONEYBOT_DEFAULT_RETENTION_CASE_DAYS=180
HONEYBOT_DEFAULT_GLOBAL_BANS_ENABLED=false

# Bot-owner capacity defaults. These are not exposed in /settings.
HONEYBOT_DEFAULT_CROSSCHANNEL_MAX_ENTRIES_PER_GUILD=10000
HONEYBOT_DEFAULT_CROSSCHANNEL_MAX_ENTRIES_PER_USER=200

# Policy defaults.
# Prevention actions: log | timeout | role | kick | ban
# Punishment actions: timeout | role | kick | ban
# Duration may be a non-negative integer seconds value, or none/null.
HONEYBOT_DEFAULT_HONEYPOT_PREVENTION_ACTION=timeout
HONEYBOT_DEFAULT_HONEYPOT_PREVENTION_DURATION_SECONDS=21600
HONEYBOT_DEFAULT_HONEYPOT_PREVENTION_ROLE_ID=
HONEYBOT_DEFAULT_HONEYPOT_PREVENTION_DELETE_MESSAGES=true

HONEYBOT_DEFAULT_CROSSCHANNEL_PREVENTION_ACTION=timeout
HONEYBOT_DEFAULT_CROSSCHANNEL_PREVENTION_DURATION_SECONDS=1800
HONEYBOT_DEFAULT_CROSSCHANNEL_PREVENTION_ROLE_ID=
HONEYBOT_DEFAULT_CROSSCHANNEL_PREVENTION_DELETE_MESSAGES=true

HONEYBOT_DEFAULT_PUNISHMENT_ACTION=ban
HONEYBOT_DEFAULT_PUNISHMENT_DURATION_SECONDS=null
HONEYBOT_DEFAULT_PUNISHMENT_ROLE_ID=
HONEYBOT_DEFAULT_PUNISHMENT_DELETE_MESSAGES=true
