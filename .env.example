DISCORD_TOKEN=replace-me
CONFIG_PATH=config/guilds.json
LOG_LEVEL=info

# Future persistence/runtime defaults
DATABASE_URL=file:data/honeybot.sqlite
IMAGE_STORAGE_DRIVER=filesystem
IMAGE_STORAGE_DIR=data/images
API_KEY_ENCRYPTION_KEY=base64-encoded-32-byte-key

# Deployment-level fallback model config. Guild `/model` settings override these.
OPENROUTER_API_KEY=replace-me
DEFAULT_TEXT_EMBEDDINGS_PROVIDER=openrouter
DEFAULT_TEXT_EMBEDDINGS_MODEL=google/gemini-embedding-2
DEFAULT_IMAGE_EMBEDDINGS_PROVIDER=openrouter
DEFAULT_IMAGE_EMBEDDINGS_MODEL=google/gemini-embedding-2
DEFAULT_EMBEDDINGS_DIMENSIONS=1536

# Rolling-window safety limits. Exhaustion should fail cases to moderator review.
MODEL_CALL_LIMIT=60
MODEL_CALL_WINDOW_SECONDS=60
MODEL_RETRY_MAX_ATTEMPTS=3
MODEL_RETRY_INITIAL_DELAY_MS=500
MODEL_RETRY_MAX_DELAY_MS=5000
MODERATION_ACTION_LIMIT=30
MODERATION_ACTION_WINDOW_SECONDS=60
EVAL_CORPUS_DIR=

# Global authority for global-ban publishing and global corpus promotion.
# team = accepted Discord Developer Team members from GET /oauth2/applications/@me
# users = comma-separated Discord user ID allowlist
GLOBAL_AUTH_MODE=team
GLOBAL_AUTH_TEAM_ID=1523848476851437578
GLOBAL_AUTH_USER_IDS=
